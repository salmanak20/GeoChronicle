# Non-secret local configuration. Copy to an untracked .env file as needed.
# Provider credentials belong in Windows Credential Manager via `keyring`.

GEOCHRONICLE_LOG_LEVEL=INFO
GEOCHRONICLE_BACKEND_HOST=127.0.0.1
GEOCHRONICLE_BACKEND_PORT=0
GEOCHRONICLE_SEARCH_PROVIDER=none
GEOCHRONICLE_SEARCH_ENDPOINT=https://api.tavily.com/search
GEOCHRONICLE_AI_PROVIDER=none
GEOCHRONICLE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
GEOCHRONICLE_AI_MODEL=gpt-4o-mini
GEOCHRONICLE_PROVIDER_TIMEOUT_SECONDS=30
GEOCHRONICLE_NARRATION_WORDS_PER_MINUTE=145

# Store provider secrets in Windows Credential Manager, for example with
# `keyring set GeoChronicle tavily` and `keyring set GeoChronicle openai`.
# Never add secret values to this file, the frontend, SQLite, or logs.
