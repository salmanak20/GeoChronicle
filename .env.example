# Placeholder configuration only. Copy to an untracked .env file when a later
# milestone defines and loads these settings. Do not put real secrets here.

GEOCHRONICLE_LOG_LEVEL=INFO
GEOCHRONICLE_BACKEND_HOST=127.0.0.1
GEOCHRONICLE_BACKEND_PORT=0
GEOCHRONICLE_TEXT_PROVIDER=replace-with-provider-id
